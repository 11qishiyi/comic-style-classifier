# ============================================================
# 上传到 GitHub 前的忽略清单
# 原则：只上传代码、模型权重与文档；不上传任何训练图片。
# ============================================================

# ---------- 数据集：全部排除（含受版权保护的漫画原图）----------
# 注意 Git 的一条规则：父目录被排除后，无法用 ! 放行其中的文件。
# 所以这里不加 "!datasets/.../manifest.csv" 这种例外——
# 需要随仓库发布的 manifest 已放到 release/manifest.csv。
datasets/

# ---------- 训练中间产物 ----------
# release/models/ 里是挑好的交付权重，其余 runs/ 产物（含交叉验证的折模型）不传
runs/
*.cache
*.log

# ---------- 预训练权重（体积大，使用者自行下载）----------
yolo11n.pt
yolo11n-cls.pt
yolo12n-cls.pt

# ---------- 凭据：绝对不要提交 ----------
.kaggle/
access_token
kaggle.json
.env

# ---------- 工具生成的临时目录 ----------
.zcode/

# ---------- 个人实验草稿（不属于本项目）----------
scratch/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
